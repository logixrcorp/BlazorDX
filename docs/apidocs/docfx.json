{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "src/BlazorDX.Components/BlazorDX.Components.csproj",
            "src/BlazorDX.Primitives/BlazorDX.Primitives.csproj",
            "src/BlazorDX.Compute/BlazorDX.Compute.csproj",
            "src/BlazorDX.Documents/BlazorDX.Documents.csproj",
            "src/BlazorDX.Documents.Parsing/BlazorDX.Documents.Parsing.csproj",
            "src/BlazorDX.Htmx/BlazorDX.Htmx.csproj",
            "src/BlazorDX.Integrations.PowerBI/BlazorDX.Integrations.PowerBI.csproj",
            "src/BlazorDX.Integrations.Reporting/BlazorDX.Integrations.Reporting.csproj",
            "src/BlazorDX.Interop/BlazorDX.Interop.csproj",
            "src/BlazorDX.Security/BlazorDX.Security.csproj"
          ],
          "src": "../.."
        }
      ],
      "dest": "api",
      "disableGitFeatures": false,
      "disableDefaultFilter": false
    }
  ],
  "build": {
    "content": [
      {
        "files": ["api/**.yml", "api/index.md"]
      },
      {
        "files": ["*.md", "toc.yml"]
      }
    ],
    "resource": [
      {
        "files": ["images/**"]
      }
    ],
    "dest": "_site",
    "globalMetadata": {
      "_appTitle": "BlazorDX API Reference",
      "_appName": "BlazorDX",
      "_appFooter": "BlazorDX — MIT licensed. Generated API reference, always in sync with the source's XML doc comments.",
      "_enableSearch": true
    },
    "template": ["default", "modern"]
  }
}
